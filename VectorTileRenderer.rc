    RTEXT           "Y:",IDC_STATIC,183,106,17,8
    EDITTEXT        IDC_EDIT_Y,208,104,54,14,ES_AUTOHSCROLL | ES_NUMBER
    CONTROL         "",IDC_SPIN_Y,"msctls_updown32",UDS_SETBUDDYINT | UDS_AUTOBUDDY | UDS_ARROWKEYS | UDS_NOTHOUSANDS,261,104,10,14
    RTEXT           "X:",IDC_STATIC,183,126,17,8
    EDITTEXT        IDC_EDIT_X,208,124,54,14,ES_AUTOHSCROLL | ES_NUMBER
    CONTROL         "",IDC_SPIN_X,"msctls_updown32",UDS_SETBUDDYINT | UDS_AUTOBUDDY | UDS_ARROWKEYS | UDS_NOTHOUSANDS,261,124,10,14
    PUSHBUTTON      "Render",IDC_BUTTON_RENDER,208,144,50,14
