IDD_FROM_SERVER_DIALOG DIALOGEX 0, 0, 317, 168
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Fetch From Server"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    RTEXT           "Server Address:",IDC_STATIC,9,18,55,8
    EDITTEXT        IDC_EDIT_SERVER,72,17,234,14,ES_AUTOHSCROLL
    RTEXT           "Zoom:",IDC_STATIC,9,40,55,8
    EDITTEXT        IDC_EDIT_ZOOM,72,38,54,14,ES_AUTOHSCROLL | ES_NUMBER
    CONTROL         "",IDC_SPIN_Z,"msctls_updown32",UDS_SETBUDDYINT | UDS_AUTOBUDDY | UDS_ARROWKEYS | UDS_NOTHOUSANDS,125,38,10,14
    CONTROL         "",IDC_STATIC,"Static",SS_BLACKFRAME,7,63,296,1,WS_EX_STATICEDGE
    RTEXT           "Latitude:",IDC_STATIC,9,76,55,8
    EDITTEXT        IDC_EDIT_LATITUDE,72,74,63,14,ES_AUTOHSCROLL
    RTEXT           "Longitude:",IDC_STATIC,9,96,55,8
    EDITTEXT        IDC_EDIT_LONGITUDE,72,94,63,14,ES_AUTOHSCROLL
    RTEXT           "Y:",IDC_STATIC,183,76,17,8
    EDITTEXT        IDC_EDIT_Y,208,74,54,14,ES_AUTOHSCROLL | ES_NUMBER
    CONTROL         "",IDC_SPIN_Y,"msctls_updown32",UDS_SETBUDDYINT | UDS_AUTOBUDDY | UDS_ARROWKEYS | UDS_NOTHOUSANDS,261,74,10,14
    RTEXT           "X:",IDC_STATIC,183,96,17,8
    EDITTEXT        IDC_EDIT_X,208,94,54,14,ES_AUTOHSCROLL | ES_NUMBER
    CONTROL         "",IDC_SPIN_X,"msctls_updown32",UDS_SETBUDDYINT | UDS_AUTOBUDDY | UDS_ARROWKEYS | UDS_NOTHOUSANDS,261,94,10,14
    PUSHBUTTON      "Render",IDC_BUTTON_RENDER,208,114,50,14
    CONTROL         "",IDC_STATIC,"Static",SS_BLACKFRAME,12,139,296,1,WS_EX_STATICEDGE
    DEFPUSHBUTTON   "Close",IDOK,260,147,50,14
    PUSHBUTTON      "Cancel",IDCANCEL,91,147,50,14,NOT WS_VISIBLE
END

